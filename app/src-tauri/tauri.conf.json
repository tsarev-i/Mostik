{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mostik",
  "mainBinaryName": "mostik",
  "identifier": "dev.mostik.client",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "bash ../scripts/ui.sh build --release"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mostik | unofficial Telemost client",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.mds.yandex.net https://files.messenger.yandex.net mostikfile: http://mostikfile.localhost; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Unofficial Yandex Telemost client",
    "longDescription": "Mostik is an unofficial Slack-like client for Yandex Telemost chats and meetings. Not affiliated with Yandex LLC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyQjhDMTZGQzJEMTE2QTgKUldTb0Z0SENiOEc0RW1Id2J6MDM5K3BMeEp4WEpTT2k1aTdSK2sxVXlpUFhjMHFnV2tIbjZ0VTgK",
      "endpoints": [
        "https://github.com/tsarev-i/Mostik/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
